APP_ENV=development
DATABASE_URL=postgresql+psycopg://book_reader:book_reader@db:5432/book_reader
JWT_SECRET=replace-with-at-least-32-random-bytes
# 32 random bytes, base64-encoded. Example: openssl rand -base64 32
BOOK_KEK_BASE64=replace-with-a-base64-encoded-32-byte-key
STORAGE_ROOT=/data/storage
ADMIN_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
MAX_PDF_BYTES=209715200
MAX_COVER_BYTES=2097152

